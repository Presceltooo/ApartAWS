# ==============================================================================
# ApartAWS Root Environment Variables Example
# Sao chép file này thành .env và điền các giá trị phù hợp trước khi chạy
# ==============================================================================

# ── AWS S3 & SES Config ──────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-apartaws-uploads-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
MAIL_FROM=support@yourdomain.com
EMAIL_ADDRESS=support@yourdomain.com
FRONTEND_URL=http://localhost:5174

# ── PostgreSQL Database Config ───────────────────────────────────────
DB_USER=user
DB_PASSWORD=password
DB_NAME=apart_booking

# ── VNPay Sandbox Config ─────────────────────────────────────────────
VNP_TMN_CODE=your-vnp-tmn-code
VNP_HASH_SECRET=your-vnp-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/bookings/payments/vnpay-return
VNP_IPN_URL=http://localhost:3000/api/bookings/payments/vnpay-ipn

# ── AWS SQS Config ───────────────────────────────────────────────────
# Khi chạy local với ElasticMQ:
SQS_ENDPOINT=http://sqs:9324
SQS_NOTIFICATION_QUEUE_URL=http://sqs:9324/000000000000/apart-notification-queue
# Khi chạy với AWS SQS thật:
# SQS_ENDPOINT=
# SQS_NOTIFICATION_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<ACCOUNT_ID>/apart-notification-queue

# ── JWT Secrets (Cho Auth Service khi chạy qua Docker) ────────────────
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── Production Image Tag (Dành cho deploy) ───────────────────────────
# IMAGE_TAG=latest
# ECR_REGISTRY=your-account-id.dkr.ecr.your-region.amazonaws.com
