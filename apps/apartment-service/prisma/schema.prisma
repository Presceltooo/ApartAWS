// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["apartment", "booking", "auth"]
}

model Apartment {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  pricePerNight Decimal   @db.Decimal(10, 2)
  cleaningFee   Decimal   @default(0.0) @db.Decimal(10, 2)
  serviceFee    Decimal   @default(0.0) @db.Decimal(10, 2)
  maxGuests     Int       @default(2)
  location      String
  amenities     String[]
  images        String[]
  isActive      Boolean   @default(true)
  isAutoApprove Boolean   @default(false)
  ownerId       String?   // Chỉ lưu ID, không có FK relation sang User
  reviews       Review[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("Apartments")
  @@schema("apartment")
}

model Review {
  id            String    @id @default(uuid())
  apartmentId   String
  tenantId      String
  bookingId     String    @unique
  rating        Int
  comment       String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@map("Reviews")
  @@schema("apartment")
}

enum Role {
  ADMIN
  OWNER
  TENANT
  @@schema("auth")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  phone              String?        @unique
  address            String?
  fullName           String?
  role               Role           @default(TENANT)
  createdAt          DateTime       @default(now())
  isActive           Boolean        @default(true)
  resetToken         String?
  resetTokenExpires  DateTime?
  refreshTokens      RefreshToken[]

  @@map("Users")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("RefreshTokens")
  @@schema("auth")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@schema("booking")
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED

  @@schema("booking")
}

model Booking {
  id                String        @id @default(uuid())
  apartmentId       String
  tenantId          String
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  totalPrice        Decimal       @db.Decimal(12, 0)
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  vnpTransactionId  String?
  paymentDate       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("Bookings")
  @@schema("booking")
}
